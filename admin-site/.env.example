# Version: V2.0 (2026-10-10) — admin-site/.env.example — V2.0
# Copy this file to ".env" and fill it in. Never commit .env to GitHub (it is git-ignored and the push scan blocks it).
# After any change run:  npm run doctor   (checks every setting and prints SkyTech codes with fixes)

# ---- Web server ----
PORT=3030
HOST=127.0.0.1            # 127.0.0.1 = only this computer can open the site (recommended). Anything else needs COOKIE_SECURE=1 + HTTPS.
# 32+ random characters. Create one with:  npm run doctor -- --new-secret   (SKY-CFG-002 if weak)
SESSION_SECRET=change-this-to-a-long-random-phrase
COOKIE_SECURE=0           # 1 only when the site is served over HTTPS (sets Secure cookie + HSTS)
TRUST_PROXY=0             # 1 only when running behind a reverse proxy that sets X-Forwarded-For

# ---- Sessions and sign-in protection ----
SESSION_IDLE_MIN=30       # sign out after this many idle minutes (SKY-AUTH-003)
SESSION_MAX_HOURS=8       # sign out after this many hours in any case
RATE_LIMIT_PER_MIN=300    # requests per minute per computer (SKY-SEC-002)
RATE_LIMIT_WRITES_PER_MIN=60

# ---- Logging (logs/runtime/admin-YYYY-MM-DD.log, JSON lines, passwords redacted) ----
LOG_LEVEL=info            # debug | info | warn | error
LOG_RETENTION_DAYS=30
LOG_DIR=                  # empty = <repo>\logs\runtime

# ---- Database: SkyTechCRM on SQL Server 2014 Developer ----
DB_SERVER=localhost        # or localhost\YOURINSTANCE  (see Services: "SQL Server (NAME)")
DB_DATABASE=SkyTechCRM
DB_AUTH=windows            # windows = use your Windows login (no password, recommended)  |  sql = SQL login below
DB_DRIVER=SQL Server Native Client 11.0   # windows auth only; or "ODBC Driver 17 for SQL Server"
DB_USER=                   # sql auth only — use the least-privilege login from sql/06 (never sa)
DB_PASSWORD=
DB_ENCRYPT=0               # 1 = encrypt the database connection (needs a certificate on SQL Server)
DB_TRUST_CERT=1            # 1 = accept the self-signed certificate of a local SQL Server

# ---- Demo mode (no database): run "npm run demo"; sign in as admin / the password below ----
DEMO_ADMIN_PASSWORD=demo1234
DEMO_SITES_DIR=            # empty = <repo>\demo-sites
