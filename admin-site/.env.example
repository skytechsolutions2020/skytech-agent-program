# Version: V1.0 (2026-10-02) — admin-site/.env.example — V1.0
# Copy this file to ".env" and fill in. Never commit .env to GitHub.

# Web server
PORT=3030
HOST=127.0.0.1            # 127.0.0.1 = only this computer can open the site
SESSION_SECRET=change-this-to-a-long-random-phrase

# Database: SkyTechCRM on SQL Server 2014 Developer
DB_SERVER=localhost        # or localhost\YOURINSTANCE  (see Services: "SQL Server (NAME)")
DB_DATABASE=SkyTechCRM
DB_AUTH=windows            # windows = use your Windows login (no password)  |  sql = SQL login below
DB_DRIVER=SQL Server Native Client 11.0   # windows auth only; or "ODBC Driver 17 for SQL Server"
DB_USER=
DB_PASSWORD=

# Demo mode (no database): run "npm run demo"; login admin / the password below
DEMO_ADMIN_PASSWORD=demo1234
